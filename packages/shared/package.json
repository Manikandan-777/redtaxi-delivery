{
  "name": "@redtaxi/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Domain types, schemas, fare engine, state machine — shared by web and mobile",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
